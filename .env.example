# Bybit API - JANGAN isi API key asli di sini
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com

# Pair & timeframe (USDT Perpetual Futures)
TRADING_SYMBOL=BTCUSDT
INTERVAL_MINUTES=15
DRY_RUN=1

# Leverage (default 1x = tanpa amplifikasi, aman)
LEVERAGE=1

# AI analyzer (via 9router proxy, OpenAI-compatible)
# Model wajib pakai prefix "ts/thirty/" agar di-routing ke reseller flash (murah).
# AI_MODELS: urutan prioritas 1..3 (utama → cadangan). Gagal 3x → pindah cadangan.
# Tiap 1 jam auto cek balik ke model utama.
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODELS=ts/thirty/deepseek-v4-flash,ts/thirty/deepseek-v4-flash-0731,ts/thirty/glm-5.0-turbo
AI_MODEL=ts/thirty/deepseek-v4-flash

# Risk management
INITIAL_CAPITAL_USDT=2000
RISK_PER_TRADE=0.005
MAX_RISK_PER_TRADE=0.01
RISK_AFTER_2_LOSS=0.0035
RISK_AFTER_3_LOSS=0.0025
RISK_LOW_CONF=0.0035
MIN_RR=1.5
TRAILING_STOP=0.005
DAILY_MAX_LOSS=0.01
COOLDOWN_HOURS=6
BREAKEVEN_TRIGGER=0.005
TIME_STOP_HOURS=4

# Keamanan tambahan
CRASH_PCT=0.03
MAX_ERRORS=10
WEB_PORT=8080
AI_CONFIDENCE_MIN=60

# Scanner market-wide (Bybit USDT Perpetual Futures)
SCAN_INTERVAL_SECONDS=180
AI_INTERVAL_SECONDS=900
SCAN_MIN_VOLUME_USD=500000
SCAN_MIN_PRICE=0.000001
SCAN_MAX_SPREAD_PCT=1.0
SCAN_MIN_PRICE_CHANGE=1.0
SCAN_TOP_CANDIDATES=30
SCAN_AI_CANDIDATES=20
SCAN_PRE_KLINE_LIMIT=40
SCAN_AI_COOLDOWN=900
SCAN_SCORE_TRIGGER=5.0

# Dashboard login (wajib — tanpa ini semua endpoint 401)
DASH_USER=
DASH_PASS=
